# Copy to .env and fill in real values (never commit .env!)

# Session signing secret (generate: python3 -c "import secrets; print(secrets.token_hex(32))")
APP_SECRET=change_me_min_32_hex_chars

# Admin password bcrypt hash (generate: python3 -c "import bcrypt; print(bcrypt.hashpw(b'password', bcrypt.gensalt()).decode())")
HASHED_PASSWORD=$2b$12$EXAMPLE_HASH_HERE

# Discord bot and target channel IDs
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
DISCORD_TEST_CHANNEL_ID=your_test_channel_id_here

# Webhook authentication
WEBHOOK_SECRET=change_me_webhook_secret

# Optional Cloudflare Access Service Token validation on webhook
CF_SERVICE_TOKEN_ID=
CF_SERVICE_TOKEN_SECRET=

# Optional Cloudflare Worker settings
CF_WORKER_URL=https://discordbot.example.workers.dev
INTERNAL_TOKEN=change_me_internal_token

# Optional comma-separated personal email filter terms (case-insensitive)
PERSONAL_FILTER_TERMS=

# Optional session lifetime in seconds (default 86400 = 24h)
SESSION_MAX_AGE=86400
